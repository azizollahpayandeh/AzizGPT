# Copy to .env and add your keys. .env is gitignored; never commit it.
#
# GROQ_API_KEY  — required. The whole stack (LLM, speech-to-text,
#                 text-to-speech) runs on Groq's OpenAI-compatible API.
#                 Create a free key at https://console.groq.com/keys
#                 Keys begin with "gsk_" and are ASCII only.
GROQ_API_KEY=

# OPENROUTER_API_KEY — optional. Only needed if you enable the openrouter
#                      entry in config.yaml as a fallback provider.
#                      Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
